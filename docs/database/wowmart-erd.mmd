erDiagram
    roles ||--o{ role_permissions : "grants"
    roles |o--o{ users : "given to staff"
    users |o--o| shops : "seller owns"
    users ||--o{ products : "owns"
    categories |o--o{ categories : "parent of"
    categories |o--o{ products : "main category"
    products }o--o{ categories : "also listed in"
    brands |o--o{ products : "brand of"
    uploads |o--o{ products : "thumbnail"
    products }o--o{ uploads : "gallery"
    products ||--|{ product_stocks : "stock"
    products ||--o{ reviews : "reviewed in"
    users ||--o{ reviews : "writes"
    users ||--o{ orders : "places"
    orders ||--|{ order_details : "contains"
    products |o--o{ order_details : "sold as"
    users ||--o{ support_tickets : "opens"
    support_tickets ||--o{ support_ticket_replies : "replies"

    users {
        int id PK
        string user_type "admin, staff, seller, customer"
        int role_id FK
        string email
    }
    roles {
        int id PK
        string name
    }
    role_permissions {
        int role_id FK
        string permission
    }
    shops {
        int id PK
        int user_id FK
        string name
    }
    products {
        int id PK
        int user_id FK
        int category_id FK
        int brand_id FK
        int thumbnail_img FK
        string name
        decimal unit_price
        int current_stock
    }
    categories {
        int id PK
        int parent_id FK
        string name
    }
    brands {
        int id PK
        string name
    }
    uploads {
        int id PK
        string file_name
    }
    product_stocks {
        int id PK
        int product_id FK
        int qty
    }
    reviews {
        int id PK
        int product_id FK
        int user_id FK
        int rating
    }
    orders {
        int id PK
        int user_id FK
        string code
        string delivery_status
        decimal grand_total
    }
    order_details {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
        decimal price
    }
    support_tickets {
        int id PK
        int user_id FK
        string status
    }
    support_ticket_replies {
        int id PK
        int support_ticket_id FK
        string reply
    }
